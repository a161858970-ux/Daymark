{
  "name": "course-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm build && pnpm --parallel --filter @course-manager/web --filter @course-manager/api run dev",
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm build && pnpm --filter @course-manager/api db:migrate",
    "db:seed": "pnpm build && pnpm --filter @course-manager/api db:seed",
    "test:postgres": "pnpm build && node scripts/test-real-postgres.mjs",
    "verify:live-api": "node scripts/verify-live-api.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
