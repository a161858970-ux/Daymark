# Development API. No client secrets belong in the web app.
PORT=3100
DATABASE_URL=postgres://course_manager:change_me@localhost:5432/course_manager
# Signed Supabase Auth access tokens are verified using this project's JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional, server only. Leave unset to keep manual and deterministic capture available.
OPENAI_API_KEY=
OPENAI_MODEL=
# Public browser configuration. Do not put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
