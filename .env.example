# Development API. No client secrets belong in the web app.
PORT=3100
DATABASE_URL=postgres://course_manager:change_me@localhost:5432/course_manager
# Disposable database used only by the isolated real-PostgreSQL integration test.
REAL_DATABASE_URL=
# Signed Supabase Auth access tokens are verified using this project's JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional, server only. Leave unset to keep manual and deterministic capture available.
# OpenAI-compatible chat-completions endpoint (MiMo by default).
AI_API_KEY=
AI_MODEL=mimo-v2.6-flash
AI_BASE_URL=https://api.xiaomimimo.com/v1
# Legacy aliases still accepted: MIMO_API_KEY / OPENAI_API_KEY, MIMO_MODEL / OPENAI_MODEL, MIMO_BASE_URL.
# Reminder engine (web). Leave VITE_REMINDER_POLICY unset to keep the engine
# disabled: production numbers stay product-gated (R-01) and are injected here,
# never hardcoded. Example shape (test/fixture values only):
# VITE_REMINDER_POLICY={"version":"dev-v1","levels":{"NORMAL":{"due_leads_ms":[86400000,3600000],"occurrence_leads_ms":[3600000],"overdue_interval_ms":14400000,"occurrence_after_interval_ms":28800000},"HIGH":{"due_leads_ms":[172800000,7200000,3600000],"occurrence_leads_ms":[7200000,3600000],"overdue_interval_ms":7200000,"occurrence_after_interval_ms":21600000}},"start_offset_ms":0,"max_per_local_day":12,"dedup_window_ms":600000}
# Optional local quiet hours for delayed (never moved earlier) delivery.
# VITE_REMINDER_QUIET_HOURS={"quietHours":{"start":"23:00","end":"07:00"},"timeZone":"Asia/Shanghai"}
# Public browser configuration. Do not put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Development seed is blocked unless this explicit switch and owner UUID are set.
ALLOW_DEVELOPMENT_SEED=0
SEED_OWNER_ID=
# Optional read-only verification of a running authenticated API.
API_BASE_URL=http://127.0.0.1:3100
SUPABASE_ACCESS_TOKEN=
