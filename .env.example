# Development API. No client secrets belong in the web app.
PORT=3100
DATABASE_URL=postgres://course_manager:change_me@localhost:5432/course_manager
# Disposable database used only by the isolated real-PostgreSQL integration test.
REAL_DATABASE_URL=
# Signed Supabase Auth access tokens are verified using this project's JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional, server only. Leave unset to keep manual and deterministic capture available.
# OpenAI-compatible chat-completions endpoint (MiMo by default).
AI_API_KEY=
AI_MODEL=mimo-v2.6-pro
AI_BASE_URL=https://api.xiaomimimo.com/v1
# Legacy aliases still accepted: MIMO_API_KEY / OPENAI_API_KEY, MIMO_MODEL / OPENAI_MODEL, MIMO_BASE_URL.
# Reminder engine (web). R-01 is fixed as product policy v1, so no variable is
# required: the engine runs with the shipped policy and 23:00-08:00 quiet hours.
# Both entries are optional overrides for experiments and tests only.
# VITE_REMINDER_POLICY={"version":"experiment-v1","levels":{"NORMAL":{"due_leads_ms":[86400000,7200000]},"HIGH":{"due_leads_ms":[86400000,14400000,3600000,900000]}},"start_offset_ms":0,"max_per_local_day":3,"dedup_window_ms":3600000}
# VITE_REMINDER_QUIET_HOURS={"quietHours":{"start":"23:00","end":"08:00"}}
# AI endpoint rate limit (server side security default, not product behaviour).
# Applies only to AI endpoints and only to authenticated owners; deterministic
# captures consume no quota. Invalid values fall back to the default.
AI_RATE_LIMIT_PER_OWNER=20
AI_RATE_LIMIT_WINDOW_MS=60000
# Public browser configuration. Do not put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Development seed is blocked unless this explicit switch and owner UUID are set.
ALLOW_DEVELOPMENT_SEED=0
SEED_OWNER_ID=
# Optional read-only verification of a running authenticated API.
API_BASE_URL=http://127.0.0.1:3100
SUPABASE_ACCESS_TOKEN=
